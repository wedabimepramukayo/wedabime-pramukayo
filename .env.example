# ─── Database (Neon PostgreSQL) ──────────────────────────────────
# Neon works for both development and production (Cloudflare Pages compatible)
# Get your free Neon DB at https://neon.tech
DATABASE_URL="postgresql://neondb_owner:your-password@ep-cool-name-region.aws.neon.tech/neondb?sslmode=require"

# ─── Authentication ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# MUST be set to a strong random value — app will crash in production if missing/placeholder
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Site URL (required for sitemap, OG tags, social posting) ────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Cloudinary (Image Storage) ──────────────────────────────────
# Sign up at https://cloudinary.com — free tier available
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Required — no default fallback for security
CLOUDINARY_UPLOAD_FOLDER=""

# ─── Cloudflare Pages Deployment ─────────────────────────────────
# In Cloudflare Pages dashboard → Settings → Environment variables:
# 1. Set ALL the above variables
# 2. Set DATABASE_URL to your Neon PostgreSQL connection string
# 3. Set NEXTAUTH_URL to your Cloudflare Pages URL (e.g. https://wedabime-pramukayo.pages.dev)
# 4. Set NEXT_PUBLIC_SITE_URL to your public domain (e.g. https://wedabimepramukayo.site)
# 5. Build command: bun run build:cf
# 6. Build output directory: .open-next/assets
# 7. Node.js version: 22
#
# After first deploy, run `prisma db push` to create the database schema:
#   DATABASE_URL="your-neon-url" npx prisma db push
