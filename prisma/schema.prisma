// Wedabime Pramukayo CMS - Database Schema
// PostgreSQL via Neon (serverless driver for Cloudflare Pages compatibility)
// Cloudinary for image storage (only URLs stored in DB)

generator client {
  provider = "prisma-client-js"
  // No binaryTargets — using PrismaNeonHttp adapter (Neon HTTP API)
  // No previewFeatures needed — driverAdapters is stable in Prisma 7
}

datasource db {
  provider = "postgresql"
  // URL is configured in prisma.config.ts for migrations
  // At runtime, PrismaNeonHttp adapter handles the connection
}

// ─── ADMIN USERS ───────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String    // bcrypt hashed password
  role          String    @default("editor") // admin, editor — least privilege by default
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── PAGES (Dynamic Content Management) ────────────────────────
model Page {
  id            String    @id @default(cuid())
  slug          String    @unique // e.g. "home", "about", "services", "advantages"
  title         String
  heroTitle     String?   // Hero section heading
  heroSubtitle  String?   // Hero section subtext
  heroImageUrl  String?   // Hero background image URL
  content       String    // Main body content (rich text / HTML)
  metaTitle     String?   // SEO title
  metaDesc      String?   // SEO description
  metaKeywords  String?   // SEO keywords (comma-separated)
  ogImageUrl    String?   // Open Graph image
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── PRODUCT CATEGORIES ────────────────────────────────────────
model ProductCategory {
  id          String    @id @default(cuid())
  slug        String    @unique // e.g. "heavy-flat-series", "designer-profile-series"
  name        String
  description String?
  icon        String?   // Icon name from Lucide
  imageUrl    String?   // Category image
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

// ─── PRODUCTS / SERVICES ───────────────────────────────────────
model Product {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  subtitle     String?
  description  String          // Main product description (rich text / HTML)
  features     String          // Key features as JSON array string
  advantages   String?         // Product-specific advantages (JSON array)
  specifications String?       // Technical specs as JSON string
  mainImageUrl String?         // Primary product image
  gallery      String?         // Additional images as JSON array of URLs
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  metaTitle    String?
  metaDesc     String?
  metaKeywords String?
  ogImageUrl   String?
  isFeatured   Boolean         @default(false)
  isPublished  Boolean         @default(true)
  publishedAt  DateTime?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// ─── BLOG POSTS ────────────────────────────────────────────────
model BlogPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String?   // Short summary for listings
  content      String    // Full blog post content (rich text / HTML)
  coverImageUrl String?  // Featured image
  author       String?   // Author name
  tags         String?   // Tags as JSON array string
  metaTitle    String?
  metaDesc     String?
  metaKeywords String?
  ogImageUrl   String?
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  socialPosts  SocialPost[]
}

// ─── SITE SETTINGS (Global Config) ─────────────────────────────
model SiteSetting {
  id          String    @id @default(cuid())
  key         String    @unique // e.g. "site_name", "meta_description", "primary_color"
  value       String    // Stored as string; parse as needed (JSON for objects)
  category    String    @default("general") // general, seo, theme, contact, social
  description String?   // Human-readable description for the admin UI
  isPublic    Boolean   @default(true) // Whether this setting is safe to expose on frontend
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── SITE IMAGES / MEDIA (Cloudinary URLs only — lightweight DB) ─
model Media {
  id            String    @id @default(cuid())
  url           String    // Cloudinary full URL (only URL stored in DB)
  cloudinaryId  String?   // Cloudinary public_id for deletion/management
  altText       String?
  filename      String?   // Original filename
  mimeType      String?   // image/jpeg, image/png, etc.
  fileSize      Int?      // Size in bytes
  width         Int?
  height        Int?
  folder        String?   // Cloudinary folder name
  uploadedBy    String?   // User ID
  createdAt     DateTime  @default(now())
}

// ─── CONTACT FORM SUBMISSIONS ──────────────────────────────────
model ContactSubmission {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?   // Optional phone number
  subject     String
  message     String
  isRead      Boolean   @default(false)
  isReplied   Boolean   @default(false)
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── SOCIAL MEDIA ACCOUNTS ────────────────────────────────────
model SocialAccount {
  id            String    @id @default(cuid())
  platform      String    // "facebook", "threads", "instagram", "blogger", "medium", "reddit"
  accessToken   String?   // OAuth access token (encrypted at rest)
  refreshToken  String?   // OAuth refresh token
  accountId     String?   // Platform-specific account/page ID
  accountName   String?   // Display name
  isActive      Boolean   @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts         SocialPost[]
}

// ─── CONTENT SECTIONS (CMS-Driven Page Sections) ──────────────
model ContentSection {
  id          String    @id @default(cuid())
  pageSlug    String    // "home", "about", "services", "advantages", "contact", "blog"
  sectionKey  String    // "hero", "advantages", "stats", "cta", "values", "intro", "features", "gallery", etc.
  type        String    // "hero", "cards", "stats", "text", "cta", "features", "gallery", "faq", "testimonials"
  title       String?
  subtitle    String?
  content     String?   // HTML content for text blocks
  items       Json?     // Array of items: [{title, desc, icon, imageUrl, value, ...}] for cards/stats/features
  imageUrl    String?   // Background/image for the section
  linkUrl     String?   // CTA link
  linkText    String?   // CTA button text
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  settings    Json?     // Section-specific settings {layout, columns, bgColor, accentColor, ...}
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([pageSlug, sectionKey])
}

// ─── SOCIAL MEDIA POSTS ───────────────────────────────────────
model SocialPost {
  id              String    @id @default(cuid())
  blogPostId      String?
  platform        String    // "facebook", "threads", "instagram", "blogger", "medium", "reddit"
  platformPostId  String?   // ID returned by the platform
  status          String    @default("pending") // pending, published, failed
  content         String?   // The post content sent
  error           String?   // Error message if failed
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())

  blogPost        BlogPost?      @relation(fields: [blogPostId], references: [id])
  socialAccount   SocialAccount  @relation(fields: [socialAccountId], references: [id])
  socialAccountId String
}
