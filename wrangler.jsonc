{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "wedabimepramukayo",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "wedabimepramukayo"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    {
      "pattern": "wedabimepramukayo.site/*",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXTAUTH_URL": "https://wedabimepramukayo.site",
    "NEXT_PUBLIC_SITE_URL": "https://wedabimepramukayo.site"
  }
}
